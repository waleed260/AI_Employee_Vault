{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "default": {
      "model": "default",
      "temperature": 0.7,
      "maxTokens": 64000,
      "instructions": "You are an AI Employee managing an Obsidian vault. Read .opencode/agents/ai-employee-brain.md for full instructions."
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "args": ["--port", "8808", "--shared-browser-context"]
    }
  }
}
